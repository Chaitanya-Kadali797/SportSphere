rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the resource owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper function to fetch target user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user document exists
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper function to check if user is Super Admin strictly by stored role
    function isSuperAdmin() {
      return isSignedIn() && userExists() && getUserData().role == "superAdmin";
    }

    // Helper function to check if user is an active Admin or Super Admin
    function isAnyAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (userExists() && getUserData().role == "admin" && (getUserData().active == true || !("active" in getUserData())))
      );
    }

    // Rules for /users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isSuperAdmin();
      // Users can update their own profile fields; Super Admin can update any field
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        (!("active" in request.resource.data) || request.resource.data.active == resource.data.active)
      );
      allow delete: if isSuperAdmin();
    }

    // Rules for /sports collection
    match /sports/{sportId} {
      allow read: if isSignedIn();
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin();
    }

    // Rules for /tournaments collection
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin();
    }

    // Rules for /tournamentRegistrations collection
    match /tournamentRegistrations/{registrationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAnyAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Rules for /certificates collection
    match /certificates/{certificateId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.participantUserId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.participantEmail == request.auth.token.email) ||
        isAnyAdmin()
      );
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
